<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SolinaFiles" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/solina_window_background</item>
    </style>

    <style name="Theme.SolinaFiles.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/solina_seed</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/icon_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SolinaFiles</item>
    </style>
</resources>
