<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#A9CFE3"
                android:centerColor="#B8DAD8"
                android:endColor="#A9DCCF"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="45"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="top|left">
        <shape android:shape="oval">
            <size android:width="280dp" android:height="280dp" />
            <gradient
                android:startColor="#38FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:gradientRadius="190dp" />
        </shape>
    </item>
    <item android:gravity="bottom|right">
        <shape android:shape="oval">
            <size android:width="300dp" android:height="300dp" />
            <gradient
                android:startColor="#3280D5C8"
                android:centerColor="#1680D5C8"
                android:endColor="#0080D5C8"
                android:type="radial"
                android:gradientRadius="210dp" />
        </shape>
    </item>
</layer-list>