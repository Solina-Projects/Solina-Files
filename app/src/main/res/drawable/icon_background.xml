<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#7896AD"
                android:centerColor="#86B8B5"
                android:endColor="#78B9AA"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2830475A"
                android:centerColor="#1830475A"
                android:endColor="#3830475A"
                android:angle="90"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#38FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="45"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="top|left">
        <shape android:shape="oval">
            <size android:width="280dp" android:height="280dp" />
            <gradient
                android:startColor="#48FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:gradientRadius="190dp" />
        </shape>
    </item>
    <item android:gravity="bottom|right">
        <shape android:shape="oval">
            <size android:width="300dp" android:height="300dp" />
            <gradient
                android:startColor="#4080D5C8"
                android:centerColor="#1A477E83"
                android:endColor="#00477E83"
                android:type="radial"
                android:gradientRadius="210dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>