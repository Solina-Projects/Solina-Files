<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted on purpose. The only code paths that use Android's HTTP stack are
  user-initiated: the plain "WebDAV" protocol (http://, typically a NAS on the local network) and
  the HTTP request tool. Both take an address the user typed, and LAN hosts are usually reached by
  IP address, which this file cannot whitelist (it matches host names, not IP ranges).
  Blocking cleartext globally would silently break WebDAV and the HTTP tool, so TLS is offered
  instead via the WEBDAVS protocol. FTP, SFTP, SMB and the LAN share servers use raw sockets and
  are not affected by this policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
